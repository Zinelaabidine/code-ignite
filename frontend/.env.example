# Copy to .env.local for local development.
#
# All three are REQUIRED — frontend/lib/env.ts throws at build time if any is
# missing, so a misconfigured build fails in CI instead of shipping a bundle
# with `undefined` baked into it.
#
# The values come from Terraform outputs:
#   cd infra/envs/dev
#   terraform output -raw cognito_user_pool_id
#   terraform output -raw cognito_client_id
#
# In CI they are injected by .github/workflows/deploy.yml at build time.
#
# None of these are secrets. A Cognito User Pool ID and public SPA client ID are
# designed to be visible in the browser bundle — the pool's password policy,
# MFA settings, and token lifetimes are what protect the account, not the
# obscurity of these IDs.

NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_CLIENT_ID=

# Optional — points the playground at the code-playground API.
# frontend/lib/env.ts resolves a missing value to `null` instead of failing
# the build, since there is no hosted API yet (see
# docs/code-playground-implementation-plan.md, stage 4). The playground route
# renders a "not available in this environment" panel when it is null.
#
# For local development, point this at the backend started with
# `docker compose up` in backend/:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
