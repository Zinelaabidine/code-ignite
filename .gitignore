# ----------------------------------------------------------------------
# Terraform
# ----------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
tfplan
tfplan.json
crash.log
debug.log
**/debug.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files hold the domain, GitHub owner, state bucket, and the list of
# IAM principals allowed to assume the local-dev role. Only the examples are
# committed; CI supplies the real values through TF_VAR_* environment
# variables sourced from GitHub Actions variables.
#
# `*.auto.tfvars` symlinks load infra/common.tfvars — keep those tracked.
*.tfvars
!*.tfvars.example
!*.auto.tfvars

# Backend configuration (bucket name) is passed at init via
# scripts/state-bucket-name.sh — not committed. Ignore accidental local copies.
backend.hcl
!backend.hcl.example

# NOTE: .terraform.lock.hcl is deliberately NOT ignored. HashiCorp's guidance is
# to commit it: it pins provider versions and records their checksums, which is
# what makes a CI apply reproducible and what verifies the integrity of a binary
# that runs with your AWS credentials. Regenerate with:
#   terraform providers lock -platform=linux_amd64 -platform=darwin_arm64

# ----------------------------------------------------------------------
# Frontend (Next.js & Node)
# ----------------------------------------------------------------------
**/node_modules/
.next/
out/

# Environment variables (prevent secret leaks)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
infra/k8s/worker/secret.env

# ----------------------------------------------------------------------
# Backend (Python)
# ----------------------------------------------------------------------
backend/.venv/
backend/build/
backend/dist/
# Host-side half of the worker's "docker outside of docker" bind mount — see
# backend/docker-compose.yml. Job source files land here transiently.
backend/.job-workspace/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ----------------------------------------------------------------------
# Keys and certificates (never commit)
# ----------------------------------------------------------------------
*.pem

# ----------------------------------------------------------------------
# OS / IDE
# ----------------------------------------------------------------------
.DS_Store
**/.DS_Store
.vscode/

# ----------------------------------------------------------------------
# Graphify (generated knowledge graph output)
# ----------------------------------------------------------------------
graphify-out/

# ----------------------------------------------------------------------
# Claude Code — local machine config (not shared)
# ----------------------------------------------------------------------
.claude/settings.json
.claude/scheduled_tasks.lock
