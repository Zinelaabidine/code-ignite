# Single source of truth for the domain-related values shared by all three
# infra/envs/* roots. Separate from common.tfvars because infra/bootstrap
# doesn't touch Route 53 or ACM and doesn't declare these variables — loading
# this file there would just produce "value for undeclared variable" warnings.
#
# One wildcard ACM certificate serves every environment, so its hosted zone
# and certificate domain are shared too. Only the per-environment `domain_name`
# (in each root's own terraform.tfvars) varies.
#
# Copy to common-domain.tfvars (gitignored) and fill in once:
#
#   cp infra/common-domain.tfvars.example infra/common-domain.tfvars
#
# Each env root picks this up automatically via a `common-domain.auto.tfvars`
# symlink that points back to this one file:
#
#   infra/envs/dev/common-domain.auto.tfvars     -> ../../common-domain.tfvars
#   infra/envs/staging/common-domain.auto.tfvars -> ../../common-domain.tfvars
#   infra/envs/prod/common-domain.auto.tfvars    -> ../../common-domain.tfvars

hosted_zone_name        = "example.com"
certificate_domain_name = "*.example.com"
