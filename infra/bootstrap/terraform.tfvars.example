# Copy to terraform.tfvars (gitignored) and fill in before the first bootstrap
# apply.
#
# aws_region, project_name, aws_account_id, github_*, hosted_zone_name, and
# certificate_domain_name live in infra/common.tfvars (see common.tfvars.example).
# State bucket and site hostnames are derived from project_name — not set here.

# AWS allows only one GitHub Actions OIDC provider per account. Leave this
# true on a fresh account. If `terraform apply` fails with
# "EntityAlreadyExists: Provider with url https://token.actions.githubusercontent.com
# already exists", set this to false and re-apply — the existing provider will
# be looked up and reused instead of recreated.
create_oidc_provider = true

# How long superseded Terraform state versions are kept (minimum 30).
state_noncurrent_version_retention_days = 90

# Decommission only: allow terraform destroy to empty and delete the state bucket.
# Run `terraform apply` once after setting this to true, then `terraform destroy`.
# state_bucket_force_destroy = true

# IAM principals allowed to assume <project_name>-local-dev-role. That role
# carries the full deploy blast radius, so assuming it requires MFA no more than
# an hour old. Leave the list empty to skip creating the role entirely.
#
# REVIEW THIS LIST BEFORE EVERY APPLY.
local_dev_iam_users = [
  # "arn:aws:iam::000000000000:user/your-admin-user",
]
