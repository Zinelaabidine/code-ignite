# Copy to infra/common.tfvars (gitignored) and fill in once for every root.
#
#   cp infra/common.tfvars.example infra/common.tfvars
#
# Loaded automatically via common.auto.tfvars symlinks in each Terraform root.
# Set project_name here only — state bucket and site FQDNs are derived.

aws_region   = "us-east-1"
project_name = "myapp"

github_owner = "your-github-owner"
github_repo  = "your-repo-name"

hosted_zone_name        = "example.com"
certificate_domain_name = "*.example.com"
