# Copy to terraform.tfvars (gitignored) and fill in.
#
# aws_region, project_name, github_owner, github_repo, and
# terraform_state_bucket live in infra/common.tfvars.example; hosted_zone_name
# and certificate_domain_name live in infra/common-domain.tfvars.example.
# Copy both to infra/common.tfvars and infra/common-domain.tfvars — see those
# files. They're loaded here automatically via the common.auto.tfvars and
# common-domain.auto.tfvars symlinks, so this file only holds this
# environment's domain and hardening knobs.
#
# In CI these are supplied as TF_VAR_* environment variables from GitHub Actions
# repository/environment variables, so no identifying values are committed.
#
# terraform_state_bucket (in common.tfvars) MUST equal the `bucket` in
# backend.hcl (infra/common-backend.hcl.example, symlinked the same way) —
# scripts/pre-commit-check.sh asserts that they match.

domain_name = "myapp-staging.example.com"

# ─── Hardening ────────────────────────────────────────────────────────────────

# Cognito MFA (TOTP): OFF | OPTIONAL | ON
mfa_configuration = "OPTIONAL"

# Cognito threat protection: OFF | AUDIT | ENFORCED.
# AUDIT and ENFORCED are billed per monthly active user.
advanced_security_mode = "AUDIT"

# WAF managed rules + per-IP rate limiting on CloudFront. Billed per web ACL,
# per rule, and per million requests.
enable_waf = false
