# One Secret per environment — copy to secret.env.dev / secret.env.prod
# (both git-ignored) and create k8s Secrets:
#
#   kubectl create secret generic codeignite-worker-env-dev \
#     --namespace codeignite \
#     --from-env-file=infra/k8s/worker/secret.env.dev \
#     --dry-run=client -o yaml | kubectl apply -f -
#
#   kubectl create secret generic codeignite-worker-env-prod \
#     --namespace codeignite \
#     --from-env-file=infra/k8s/worker/secret.env.prod \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# CODEIGNITE_* values come from Terraform outputs for that env:
#   cd infra/envs/<dev|prod>
#   terraform output -raw jobs_bucket_name
#   terraform output -raw runs_queue_url
#   terraform output -raw cognito_user_pool_id
#   terraform output -raw cognito_client_id
#
# AWS keys must be allowed on BOTH the env's SQS queue and jobs bucket
# (see infra/modules/run-pipeline/iam-runtime.tf). One IAM user with both
# run-worker policies attached works; separate users per env is fine too.
#
# codeignite.config.Settings validates ALL CODEIGNITE_* vars at startup.

# --- secret.env.dev ---
# CODEIGNITE_AWS_REGION=us-east-1
# CODEIGNITE_JOBS_BUCKET=codeignite-dev-jobs
# CODEIGNITE_RUNS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account>/codeignite-dev-runs
# CODEIGNITE_COGNITO_USER_POOL_ID=
# CODEIGNITE_COGNITO_CLIENT_ID=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- secret.env.prod ---
# CODEIGNITE_AWS_REGION=us-east-1
# CODEIGNITE_JOBS_BUCKET=codeignite-prod-jobs
# CODEIGNITE_RUNS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account>/codeignite-prod-runs
# CODEIGNITE_COGNITO_USER_POOL_ID=
# CODEIGNITE_COGNITO_CLIENT_ID=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
