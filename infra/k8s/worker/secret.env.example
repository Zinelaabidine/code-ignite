# Copy to secret.env (git-ignored) and fill in real values, then create the
# k8s Secret from it:
#
#   kubectl create secret generic codeignite-worker-env \
#     --namespace codeignite \
#     --from-env-file=infra/k8s/worker/secret.env
#
# The first five come from Terraform outputs, same as backend/.env.example:
#   cd infra/envs/dev
#   terraform output -raw jobs_bucket_name
#   terraform output -raw runs_queue_url
#   terraform output -raw cognito_user_pool_id
#   terraform output -raw cognito_client_id
#
# codeignite.config.Settings validates ALL of these eagerly at process
# startup (env_prefix="CODEIGNITE_") — the pod CrashLoopBackOffs immediately
# if even one is missing, same as `docker compose up` locally.

CODEIGNITE_AWS_REGION=us-east-1
CODEIGNITE_JOBS_BUCKET=
CODEIGNITE_RUNS_QUEUE_URL=
CODEIGNITE_COGNITO_USER_POOL_ID=
CODEIGNITE_COGNITO_CLIENT_ID=

# boto3 reads these two directly (see queue.py / objects.py client
# construction). On your Mac, docker-compose.yml mounts ~/.aws and uses
# AWS_PROFILE — there is no such thing as a "profile" on an on-prem node, so
# the pod needs real, long-lived credentials instead. Least-privilege: an
# IAM user/role limited to exactly the run-pipeline SQS queue + S3 bucket
# (see infra/modules/run-pipeline/iam-runtime.tf for the policy to mirror).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if the above are temporary STS credentials rather than a
# plain IAM user's long-lived keys.
# AWS_SESSION_TOKEN=
