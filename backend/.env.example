# Copy to backend/.env for local development. Read by
# codeignite.config.Settings (pydantic-settings) — see that module for the
# full, authoritative contract.
#
# The first five are REQUIRED — config.py throws at process startup if any
# is missing, the same "fail loudly instead of shipping something broken"
# contract frontend/lib/env.ts uses. Get them from Terraform outputs:
#   cd infra/envs/dev
#   terraform output -raw jobs_bucket_name
#   terraform output -raw runs_queue_url
#   terraform output -raw cognito_user_pool_id
#   terraform output -raw cognito_client_id

CODEIGNITE_AWS_REGION=us-east-1
CODEIGNITE_JOBS_BUCKET=
CODEIGNITE_RUNS_QUEUE_URL=

# Same User Pool and app client the frontend uses (frontend/.env.example) —
# not secrets, see config.py's docstring.
CODEIGNITE_COGNITO_USER_POOL_ID=
CODEIGNITE_COGNITO_CLIENT_ID=

# Everything below has a working default — set only to override.
CODEIGNITE_RUNNER_BACKEND=local_docker
CODEIGNITE_MAX_EXECUTION_SECONDS=10
CODEIGNITE_LOG_LEVEL=INFO
# Comma-separated origins allowed to call this API from a browser.
CODEIGNITE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Not read by codeignite.config — used directly by boto3 (and by
# docker-compose.yml, which passes it through) to select which profile in
# your mounted ~/.aws carries the local-dev role's credentials.
AWS_PROFILE=

# "Docker outside of Docker" support for LocalDockerRunner — see config.py.
# docker-compose.yml sets both of these itself for the worker container; you
# don't need to set them here for `docker compose up`. Leave unset when
# running the worker directly (`python -m codeignite.worker`) — there's
# nothing to translate when the runner talks straight to your local daemon.
CODEIGNITE_JOB_WORKSPACE_DIR=
CODEIGNITE_HOST_JOB_WORKSPACE_DIR=
