# Copy to backend/.env for local development. Read by
# codeignite.config.Settings (pydantic-settings) — see that module for the
# full, authoritative contract. All three below have working defaults, so
# nothing here is strictly required yet.
#
# Stage 2 (async runs) adds AWS_REGION, JOBS_BUCKET and RUNS_QUEUE_URL once
# there is an actual queue and bucket — created by
# infra/modules/run-pipeline — to point at. Those will be required, the way
# frontend/.env.example's variables are: missing one fails startup instead of
# shipping a worker that silently can't reach its queue.

CODEIGNITE_RUNNER_BACKEND=local_docker
CODEIGNITE_MAX_EXECUTION_SECONDS=10
CODEIGNITE_LOG_LEVEL=INFO
