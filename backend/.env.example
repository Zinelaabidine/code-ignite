# Copy to backend/.env for local development. Read by
# codeignite.config.Settings (pydantic-settings) — see that module for the
# full, authoritative contract.
#
# The first three are REQUIRED — config.py throws at process startup if any
# is missing, the same "fail loudly instead of shipping something broken"
# contract frontend/lib/env.ts uses. Get them from Terraform outputs:
#   cd infra/envs/dev
#   terraform output -raw jobs_bucket_name
#   terraform output -raw runs_queue_url

CODEIGNITE_AWS_REGION=us-east-1
CODEIGNITE_JOBS_BUCKET=
CODEIGNITE_RUNS_QUEUE_URL=

# Everything below has a working default — set only to override.
CODEIGNITE_RUNNER_BACKEND=local_docker
CODEIGNITE_MAX_EXECUTION_SECONDS=10
CODEIGNITE_LOG_LEVEL=INFO

# Not read by codeignite.config — used directly by boto3 (and by
# docker-compose.yml, which passes it through) to select which profile in
# your mounted ~/.aws carries the local-dev role's credentials.
AWS_PROFILE=
