# The API — never touches the Docker socket. Its only job is to validate a
# request, write jobs/{job_id}/input.json to S3, and send the job ID to SQS.
# See docs/code-playground-implementation-plan.md §0 for why keeping the
# socket off this container's request path matters: a process that can hit
# /var/run/docker.sock is effectively root on the host, and this is the one
# process here that's directly reachable from the network.
FROM python:3.14-slim

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src

# [server] pulls in uvicorn — split out of the base dependencies because the
# hosted Lambda deployment (api/lambda_handler.py) never runs a server
# process. See pyproject.toml's [project.optional-dependencies] comment.
RUN pip install --no-cache-dir ".[server]"

EXPOSE 8000

CMD ["uvicorn", "codeignite.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
